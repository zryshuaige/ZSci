# --- Python / uv ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / Vite ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
*.log

# tsc -b build artifacts (must not shadow vite.config.ts)
vite.config.js
vite.config.d.ts
*.tsbuildinfo

# Frontend tests (smoke tests live under tests/, gitignored — keep
# locally for `npm run test:smoke`, not committed)
frontend/tests/

# --- ZSci workspace (local data, never commit) ---
# Anchor to the repo root: a bare `workspace/` would also exclude
# backend/app/workspace/ (a real source package).
/workspace/
!/workspace/.gitkeep

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# --- AI coding tools (local plans / artifacts / sessions) ---
.zcode/
.claude/
.agents/
.cursor/
design.md

# --- Secrets ---
.env
.env.*
!.env.example
*.key

