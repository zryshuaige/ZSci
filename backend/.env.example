# Z-Sci backend environment variables.
# Copy to `backend/.env` and fill in the keys for the providers you configured
# in `workspace/.research-agent/config.yaml`. Only set the ones you use.

# OpenAI (provider: openai)
# OPENAI_API_KEY=sk-...

# DeepSeek (provider: deepseek) — cheap default for translation + notes
# DEEPSEEK_API_KEY=sk-...

# Anthropic Claude (provider: anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (provider: gemini)
# GEMINI_API_KEY=...

# 通义千问 / Qwen (provider: qwen)
# DASHSCOPE_API_KEY=...

# 智谱 / Zhipu (provider: zhipu)
# ZHIPUAI_API_KEY=...

# Local Ollama (provider: ollama) — key is ignored by ollama; set any value
# OLLAMA_API_KEY=ollama

# Local OpenAI-compatible server (vLLM / LM Studio) (provider: openai + base_url)
# LOCAL_LLM_API_KEY=any

# SiliconFlow / 硅基流动 (provider: openai + base_url) — GLM-4.7 等推理模型
# SILICONFLOW_API_KEY=sk-...

# --- Optional app settings (all have sensible defaults) ---
# ZSCI_WORKSPACE_PATH=/Users/zry/Desktop/code/ZSci/workspace
# ZSCI_LLM_CONFIG_PATH=
